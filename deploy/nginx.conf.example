server {
    listen 80;
    listen [::]:80;
    server_name pagina-host.local localhost;

    root /var/www/pagina-host;
    index index.html;

    access_log /var/log/nginx/pagina-host.access.log;
    error_log  /var/log/nginx/pagina-host.error.log;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location ~* \.(?:css|js|woff2?|svg|png|jpg|jpeg|gif|ico)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location = /favicon.ico {
        log_not_found off;
        access_log off;
    }

    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types
        text/plain
        text/css
        text/xml
        text/javascript
        application/javascript
        application/json
        application/xml
        application/xml+rss
        image/svg+xml;
}
